@page "/"

<PageTitle>KyarKwat — @ModeName(game.Mode)</PageTitle>
<div class="app-shell">
  <header class="masthead">
    <a class="wordmark" href="./" aria-label="KyarKwat မူလစာမျက်နှာ">
      <svg viewBox="0 0 32 32" width="32" height="32" fill="none" aria-hidden="true"><path d="M3 3h12v12H3zm14 14h12v12H17z" fill="currentColor"/><circle cx="23" cy="9" r="6" stroke="currentColor" stroke-width="2"/><circle cx="9" cy="23" r="6" stroke="currentColor" stroke-width="2"/></svg>
      <span>KyarKwat <small>မြန်မာ့ရိုးရာ ကျားကွက်</small></span>
    </a>
    <button class="text-button" id="open-rules" @onclick='() => OpenDialogAsync("rules")'>ကစားနည်း <span aria-hidden="true">↗</span></button>
  </header>
  <main>
    <div class="title-row">
      <div><h1 id="mode-title">@ModeName(game.Mode)</h1><p id="objective">@Objective(game.Mode)</p></div>
      <button class="primary" id="new-game" @onclick="OpenSetupAsync">ဂိမ်းအသစ် <span aria-hidden="true">＋</span></button>
    </div>
    <div class="game-layout">
      <section class="play-area" aria-label="ကျားကွက်ခုံ">
        <div class="player-row opponent-row">
          <div class="player-name"><span class="counter ivory" aria-hidden="true"></span><div><strong id="opponent-name">@(computerOpponent ? "စက်ကစားသမား" : "အဖြူကျား ကစားသမား")</strong><small id="opponent-level">@(computerOpponent ? level.ToString() : "တစ်စက်တည်းမှာ နှစ်ယောက်ကစားခြင်း")</small></div></div>
          <div class="piece-count"><strong id="opponent-count">@game.Count(Side.Ivory)</strong><span>ကျားကျန်</span></div>
        </div>
        <div class="board-frame">
          <div class="board-coordinates" aria-hidden="true">@foreach (var letter in "abcdefgh") { <span>@letter</span> }</div>
          <div class="board-with-ranks">
            <div class="ranks" aria-hidden="true">@for (var rank = 8; rank > 0; rank--) { <span>@rank</span> }</div>
            <div id="board" class="board" aria-label="ကျားကွက်ခုံ၊ မြားခလုတ်များဖြင့် ရွေးနိုင်ပါသည်">
              @for (var index = 0; index < 64; index++)
              {
                var square = index;
                var piece = DisplayPiece(square);
                <button type="button" @key="square" data-index="@square" class="@SquareClass(square)"
                        disabled="@(!GameRules.Playable(square) || BoardLocked)" tabindex="@(square == focusedSquare ? 0 : -1)"
                        aria-label="@SquareLabel(square)" aria-pressed="@(CurrentSquare == square ? "true" : "false")"
                        @onfocus="() => focusedSquare = square" @onkeydown="e => BoardKeyDownAsync(e, square)" @onclick="() => SelectSquareAsync(square)">
                  @if (piece is { } counter)
                  {
                    <span class="counter @SideClass(counter.Side)" aria-hidden="true">@if (counter.King) { <span class="king-letter">က</span> }</span>
                  }
                </button>
              }
            </div>
          </div>
        </div>
        <div class="player-row own-row">
          <div class="player-name"><span class="counter green" aria-hidden="true"></span><div><strong id="human-name">@(computerOpponent ? "သင်" : "အစိမ်းကျား ကစားသမား")</strong><small>အစိမ်းကျား · အရင်ရွှေ့ပါသည်</small></div></div>
          <div class="piece-count"><strong id="human-count">@game.Count(Side.Green)</strong><span>ကျားကျန်</span></div>
        </div>
        <div class="board-key"><span><i class="key-ring" aria-hidden="true"></i>ရွေးထားသောကျား</span><span><i class="key-dot" aria-hidden="true"></i>ရွှေ့နိုင်သောကွက်</span><span><i class="key-king" aria-hidden="true">က</i>ကင်း</span></div>
      </section>
      <aside class="match-panel" aria-label="ကစားပွဲအချက်အလက်">
        <section class="turn-section" aria-labelledby="turn-title">
          <div role="status" aria-live="polite" aria-atomic="true">
            <p class="status-label">လက်ရှိအလှည့်</p>
            <div class="turn-heading"><span class="turn-dot @SideClass(game.Turn)" aria-hidden="true"></span><h2 id="turn-title">@TurnTitle</h2></div>
            <p id="turn-description">@TurnDescription</p>
          </div>
          @if (MustCapture) { <p class="capture-notice" id="capture-notice">စားနိုင်သောကြောင့် မဖြစ်မနေ စားရပါမည်။ အများဆုံးစားနိုင်သော လမ်းကို ရွေးပါ။</p> }
          @if (game.Result is not null) { <button class="secondary" id="show-result" @onclick='() => OpenDialogAsync("result")'>ရလဒ်ကြည့်ရန်</button> }
          @if (computerError is not null) { <p role="alert">@computerError</p><button class="secondary" id="retry-ai" @onclick="RunComputerAsync">ထပ်စမ်းရန်</button> }
        </section>
        <section class="match-settings" aria-label="လက်ရှိကစားပွဲ">
          <h2>ကစားပွဲ</h2>
          <dl><div><dt>ကစားနည်း</dt><dd id="summary-mode">@ModeName(game.Mode)</dd></div><div><dt>ပြိုင်ဘက်</dt><dd id="summary-opponent">@(computerOpponent ? "စက်" : "နှစ်ယောက်")</dd></div>
            @if (computerOpponent) { <div id="summary-level-row"><dt>အဆင့်</dt><dd id="summary-level">@level</dd></div> }
          </dl>
          <button class="secondary" id="change-settings" @onclick="OpenSetupAsync">ကစားပွဲ ပြင်ဆင်ရန်</button>
        </section>
        <section class="objective-section">
          <h2>@(ModeName(game.Mode))မှာ ဘယ်လိုနိုင်မလဲ။</h2><p>@Details(game.Mode)</p>
          <button class="text-button" id="more-rules" @onclick='() => OpenDialogAsync("rules")'>စည်းမျဉ်းအပြည့်အစုံ <span aria-hidden="true">→</span></button>
        </section>
        <p class="quiet-note">စားနိုင်ရင် စားရမယ်။<br />ဆက်စားနိုင်ရင် ဆက်စားရမယ်။</p>
      </aside>
    </div>
  </main>
  <footer><span>ကျားကွက်တစ်ခုံ။ ကစားနည်းနှစ်မျိုး။</span><span>ကျားနိုင် / ကျားကုန်</span></footer>
</div>

<dialog id="setup-dialog" aria-labelledby="setup-title">
  <form id="setup-form" @onsubmit="StartGameAsync" @onsubmit:preventDefault>
    <div class="dialog-heading"><h2 id="setup-title">ကစားပွဲအသစ်</h2><button type="button" class="close-button" @onclick="CloseDialogAsync" aria-label="ပိတ်ရန်">×</button></div>
    <p class="dialog-intro">ကစားနည်းရွေးပြီး စတင်လိုက်ပါ။</p>
    <fieldset class="mode-options"><legend>ကစားနည်း</legend>
      @foreach (var mode in Enum.GetValues<GameMode>())
      {
        <label class="mode-option"><input type="radio" name="mode" value="@mode" checked="@(draftMode == mode)" @onchange="() => draftMode = mode" /><span><strong>@ModeName(mode)</strong><small>@(mode == GameMode.Normal ? "ပြိုင်ဘက်ကျားတွေကို စားပါ။" : "ကိုယ့်ကျားတွေကို စားအောင် ခင်းပေးပါ။")</small></span><span class="radio-mark" aria-hidden="true"></span></label>
      }
    </fieldset>
    <fieldset><legend>ပြိုင်ဘက်</legend><div class="segmented opponent-options">
      <label><input type="radio" name="opponent" value="computer" checked="@draftComputer" @onchange="() => draftComputer = true" /><span>စက်နဲ့ကစားမယ်</span></label>
      <label><input type="radio" name="opponent" value="local" checked="@(!draftComputer)" @onchange="() => draftComputer = false" /><span>နှစ်ယောက်ကစားမယ်</span></label>
    </div></fieldset>
    @if (draftComputer)
    {
      <fieldset id="difficulty-field"><legend>စက်ရဲ့အဆင့်</legend><div class="segmented">
        @foreach (var difficulty in Enum.GetValues<Difficulty>())
        {
          <label><input type="radio" name="level" value="@difficulty" checked="@(draftLevel == difficulty)" @onchange="() => draftLevel = difficulty" /><span>@difficulty</span></label>
        }
      </div><p class="field-note">@LevelDescription</p></fieldset>
    }
    <p class="setup-objective">@Details(draftMode)</p>
    <p class="field-note">ဂိမ်းအသစ်စရင် လက်ရှိကစားပွဲကို အစားထိုးပါမယ်။</p>
    <button class="primary full-width" type="submit">စကစားမယ် <span aria-hidden="true">→</span></button>
  </form>
</dialog>

<dialog id="rules-dialog" aria-labelledby="rules-title">
  <div class="dialog-heading"><h2 id="rules-title">ကစားနည်း</h2><button class="close-button" @onclick="CloseDialogAsync" aria-label="ပိတ်ရန်">×</button></div>
  <div class="rule-content">
    <section><h3>ကျားနိုင်</h3><p>@Details(GameMode.Normal)</p></section>
    <section><h3>ကျားကုန်</h3><p>@Details(GameMode.Reverse) Feed ဆိုတာ ကိုယ့်ကျားကို ပြိုင်ဘက်စားနိုင်အောင် တရားဝင်ရွှေ့ကွက်နဲ့ ခင်းပေးတာပါ။</p></section>
    <section><h3>ရွှေ့ခြင်းနဲ့ စားခြင်း</h3><p>တစ်ဖက်စီ ကျား ၁၂ ကောင်နဲ့ စပါတယ်။ ရိုးရိုးကျားက ရှေ့ထောင့်ဖြတ် တစ်ကွက်ရွှေ့ပြီး ရှေ့ဘက်ကို ခုန်စားနိုင်ပါတယ်။ စားနိုင်ရင် မဖြစ်မနေစားပြီး အများဆုံးစားနိုင်တဲ့လမ်းကို ရွေးရပါတယ်။ ဆက်စားနိုင်သေးရင် အဲဒီကျားနဲ့ပဲ ဆက်စားပါ။ စားပြီးသောကျားတွေက အလှည့်အဆုံးမှ ခုံပေါ်က ဖယ်ရှားပါတယ်။</p></section>
    <section><h3>ကင်းနဲ့ သရေ</h3><p>အလှည့်အဆုံးမှာ တစ်ဖက်အစွန်ရောက်တဲ့ကျားက ကင်းဖြစ်ပါတယ်။ ကင်းက ရှေ့နောက် ထောင့်ဖြတ်အတိုင်း အဝေးရွှေ့၊ အဝေးစားနိုင်ပါတယ်။ ကျားမစားဘဲ ကင်းသာ တစ်ဖက်စီ ၂၅ ကြိမ်ဆက်တိုက် ရွှေ့ရင် သရေပါ။</p></section>
  </div>
  <button class="primary full-width" @onclick="CloseDialogAsync">နားလည်ပါပြီ</button>
</dialog>

<dialog id="result-dialog" aria-labelledby="result-title" aria-describedby="result-reason">
  <div class="dialog-heading"><span class="status-label">ကစားပွဲ ပြီးဆုံးပါပြီ</span><button class="close-button" @onclick="CloseDialogAsync" aria-label="ခုံကို ပြန်ကြည့်ရန်">×</button></div>
  @if (game.Result?.Winner is { } winner) { <div class="result-mark" aria-hidden="true"><span class="counter @SideClass(winner)"></span></div> }
  <h2 id="result-title">@ResultTitle</h2><p id="result-reason">@ResultDescription</p>
  <dl class="result-summary"><div><dt>ကစားနည်း</dt><dd>@ModeName(game.Mode)</dd></div><div><dt>အစိမ်းကျားကျန်</dt><dd>@game.Count(Side.Green)</dd></div><div><dt>အဖြူကျားကျန်</dt><dd>@game.Count(Side.Ivory)</dd></div></dl>
  <button class="primary full-width" id="play-again" @onclick="ReplayAsync">ထပ်ကစားမယ် <span aria-hidden="true">→</span></button>
  <button class="text-button full-width" @onclick="CloseDialogAsync">ခုံကို ပြန်ကြည့်မယ်</button>
</dialog>
